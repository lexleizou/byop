{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "BYOP P12a canonical runtime tokens. This file is the single product token source consumed by the native shell and published to plugin WebViews.",
  "meta": {
    "name": "BYOP Product Tokens",
    "product": "Build You Own Pi",
    "version": "0.3.0",
    "updated": "2026-10-24",
    "status": "P12a foundation",
    "format": "project DTCG-style; not a formal schema conformance claim",
    "radix": {
      "repository": "https://github.com/radix-ui/colors",
      "commit": "dbdb85470547c7d34b9001f48fddb08ded335979",
      "palettes": [
        "sand",
        "orange",
        "jade",
        "red",
        "amber"
      ],
      "roleRule": "1/2 backgrounds, 3/4/5 control states, 6/7/8 borders, 9/10 solid colors, 11/12 text"
    },
    "glass": {
      "dependency": "github.com/egoist/mygo v0.5.5",
      "source": "plugins/glass/glass.go",
      "implementation": "MyGo Liquid Glass shader material with GPU/CPU backdrop blur and refraction; not NSGlassEffectView",
      "interactive": false,
      "intrinsicRim": "The material paints a 1px optical rim; this is not the application 0.5px border."
    },
    "compatibility": {
      "extensions": "tokens.extensions.json remains a merge and migration source during P12."
    }
  },
