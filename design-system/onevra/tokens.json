        },
        "text": {
          "$value": "#33332f",
          "$description": "Primary foreground text."
        },
        "textMuted": {
          "$value": "#72726a",
          "$description": "Secondary and supporting text."
        },
        "accent": {
          "$value": "#bd481b",
          "$description": "Terracotta Onevra primary accent. This is not the neutral --accent token used by the Onevra marketing site."
        },
        "accentHover": {
          "$value": "#a63f18",
          "$description": "Accent mixed 12% toward black with MyGo Color.Mix.",
          "$extensions": {
            "com.onevra.derivation": {
              "expression": "accent.Mix(black, 0.12)",
              "rounding": "floor(channel * (1 - t) + target * t + 0.5)"
            }
          }
        },
        "accentPressed": {
          "$value": "#8e3614",
          "$description": "Accent mixed 25% toward black with MyGo Color.Mix.",
          "$extensions": {
            "com.onevra.derivation": {
              "expression": "accent.Mix(black, 0.25)",
              "rounding": "floor(channel * (1 - t) + target * t + 0.5)"
            }
          }
        },
        "accentText": {
          "$value": "#ffffff",
          "$description": "Text and icons placed on the primary accent."
        },
        "danger": {
          "$value": "#b4444c",
          "$description": "Destructive and failure state."
        },
        "warning": {
          "$value": "#b45309",
          "$description": "Warning state; intentionally distinct from danger."
        },
        "success": {
          "$value": "#059669",
          "$description": "Success and completed state."
