        },
        "surface": {
          "$value": "#fefefd",
          "$description": "Cards, raised surfaces, and the composer."
        },
        "surfaceHover": {
          "$value": "#eceae4",
          "$description": "Hover state for neutral controls and navigation rows."
        },
        "surfacePressed": {
          "$value": "#d9d7d2",
          "$description": "Pressed state for neutral controls."
        },
        "border": {
          "$value": "#deded5",
