{
  "schemaVersion": 1,
  "id": "example.locale-fixture",
  "name": "%manifestName%",
  "version": "0.1.0",
  "description": "%manifestDescription%",
  "runtime": "node",
  "entry": "fixture-inert.mjs",
  "icon": "languages",
  "compatibility": {
    "host": ">=0.19.0 <1.0.0",
    "pluginApi": "1"
