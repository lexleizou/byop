{
  "schemaVersion": 1,
  "id": "example.hello-webview",
  "name": "%manifestName%",
  "version": "0.1.0",
  "description": "%manifestDescription%",
  "l10n": "l10n",
  "runtime": "node",
  "entry": "plugin.mjs",
  "icon": "plugins",
  "compatibility": {
    "host": ">=0.5.0 <1.0.0",
    "pluginApi": "1"
  },
  "contributes": {
    "navigation": [
      {
        "id": "hello-web",
        "title": "%navigationTitle%",
        "icon": "plugins",
        "view": "hello.web"
      }
    ],
    "webviews": [
      {
        "id": "hello.web",
        "title": "%webviewTitle%",
        "location": "main",
        "entry": "web/index.html"
      }
    ]
  },
  "activation": {
    "events": [
      "onWebView:hello.web"
    ]
  },
  "capabilities": {
    "workspace": "read",
    "files": "none",
    "network": false,
    "process": "none"
  }
}
